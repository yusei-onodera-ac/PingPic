rules_version = '2';

// PingPic Firestore security rules.
//
// Field names below are camelCase, matching packages/shared-types/src/index.ts
// (the source of truth for document shapes) and the hand-mirrored Dart
// models in mobile/lib/**/data/*_model.dart — NOT snake_case. Keep these in
// sync; a mismatch here silently breaks every write (the field just reads
// as `null` and every equality check fails closed).
//
// Cloud Functions (Admin SDK) bypass these rules entirely, so the 00:00
// batch job's writes to daily_schedules/posts/prompt_suggestions are not
// affected by anything below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Deterministic connections/{...} doc id for a pair of uids, order-
    // independent — mirrors packages/shared-types/src/index.ts's
    // connectionId() and mobile's ConnectionRepository. Keep all three
    // in sync.
    function connectionId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isConnected(a, b) {
      return exists(/databases/$(database)/documents/connections/$(connectionId(a, b)));
    }

    // Can the requester see this uid's posts at all (their own, or as a
    // mutual connection)? Individual posts additionally check isPublic —
    // see posts.allow read below.
    function canSeeUsersPosts(uid) {
      return request.auth.uid == uid || isConnected(request.auth.uid, uid);
    }

    // --- daily_schedules/{date} ---
    // date doc id format: "YYYY-MM-DD". Holds `slots: ScheduleSlot[3]`,
    // each { sendTime, promptText, credit }.
    match /daily_schedules/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- friend_requests/{fromUid}_{toUid} ---
    // { fromUid, toUid, fromDisplayName, status: "pending", createdAt }
    // Plain client writes — the constraint per doc is simple enough not
    // to need a Cloud Function. Either the sender (cancel) or the
    // recipient (reject) can delete a pending request; ACCEPTING one is
    // NOT a delete-only operation (it also has to create a `connections`
    // doc atomically), so that path goes through the
    // respondToFriendRequest callable instead — see connections below.
    match /friend_requests/{requestId} {
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isSignedIn()
                  && (request.auth.uid == resource.data.fromUid
                      || request.auth.uid == resource.data.toUid);
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.fromUid
                        || request.auth.uid == resource.data.toUid);
      allow update: if false;
    }

    // --- connections/{sortedUidA}_{sortedUidB} ---
    // { uids: [sortedUidA, sortedUidB], displayNames: {uid: name}, createdAt }
    // Created ONLY by the respondToFriendRequest Cloud Function callable
    // (Admin SDK) — never a direct client create, since accepting a
    // request needs to atomically also delete the request doc, which a
    // plain rules-only client write can't coordinate. Deleting one
    // ("unfriend") needs no such coordination, so that IS a plain client
    // write, by either party.
    match /connections/{connectionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow create: if false;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow update: if false;
    }

    // --- posts/{postId} ---
    // { userId, authorDisplayName, date, slotNumber, photoUrl, postedAt,
    //   promptText, isPublic, caption, likeCount }
    match /posts/{postId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    // likeCount must start at 0 — only the likes trigger
                    // (Admin SDK) ever changes it after creation.
                    && request.resource.data.likeCount == 0;
      // Visible to the author and their mutual connections always (this
      // is what used to be "your group can see it"); visible to ANYONE
      // signed in if the author additionally chose to make it public
      // (the "みんなの投稿" feed) — see Post.isPublic's doc comment in
      // shared-types.
      allow read: if isSignedIn()
                  && (resource.data.isPublic == true || canSeeUsersPosts(resource.data.userId));
      // Authors don't edit/delete posts per spec (no editing feature).
      // likeCount is the one field non-admins never touch directly either
      // — see posts/{postId}/likes/{uid} below, which drives it via a
      // server-side trigger instead of a client-writable counter.
      allow update, delete: if isAdmin();

      // --- posts/{postId}/likes/{uid} ---
      // Doc id IS the liker's uid — "like" = create this doc,
      // "unlike" = delete it. Existence alone is the signal (see Like's
      // doc comment in shared-types). Anyone who can read the post can
      // see (and cast) likes on it; a user can only create/delete their
      // OWN like doc, never anyone else's.
      match /likes/{uid} {
        allow read: if isSignedIn()
                    && (get(/databases/$(database)/documents/posts/$(postId)).data.isPublic == true
                        || canSeeUsersPosts(get(/databases/$(database)/documents/posts/$(postId)).data.userId));
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false; // no fields to update — recreate instead
      }

      // --- posts/{postId}/comments/{commentId} ---
      // { userId, displayName, text, createdAt }
      match /comments/{commentId} {
        allow read: if isSignedIn()
                    && (get(/databases/$(database)/documents/posts/$(postId)).data.isPublic == true
                        || canSeeUsersPosts(get(/databases/$(database)/documents/posts/$(postId)).data.userId));
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280;
        // No edit/delete-by-author for the same reason posts themselves
        // don't have one — keep the "no editing" posture consistent.
        allow update, delete: if isAdmin();
      }
    }

    // --- prompt_suggestions/{suggestionId} ---
    // { suggestionText, submitterInfo: { uid, displayName }, status, createdAt }
    match /prompt_suggestions/{suggestionId} {
      allow create: if isSignedIn()
                    && request.resource.data.submitterInfo.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.submitterInfo.uid == request.auth.uid);
      allow update: if isAdmin(); // approve/reject transitions are admin-only
      allow delete: if isAdmin();
    }

    // --- prompt_pool/{entryId} ---
    // "Popular prompt" stock used by the 00:00 auto-fill batch job.
    // { promptText, usageCount, createdAt }
    match /prompt_pool/{entryId} {
      allow read: if isAdmin(); // not user-facing; batch job reads via Admin SDK anyway
      allow write: if isAdmin();
    }

    // Default deny — anything not explicitly matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

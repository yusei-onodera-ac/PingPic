rules_version = '2';

// PingPic Firestore security rules.
//
// Field names below are camelCase, matching packages/shared-types/src/index.ts
// (the source of truth for document shapes) and the hand-mirrored Dart
// models in mobile/lib/**/data/*_model.dart — NOT snake_case. Keep these in
// sync; a mismatch here silently breaks every write (the field just reads
// as `null` and every equality check fails closed).
//
// Cloud Functions (Admin SDK) bypass these rules entirely, so the 00:00
// batch job's writes to daily_schedules/posts/prompt_suggestions, and
// createGroup/joinGroupByInviteCode's writes to groups/invite_codes, are
// not affected by anything below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isGroupMember(groupId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // --- daily_schedules/{date} ---
    // date doc id format: "YYYY-MM-DD". Holds `slots: ScheduleSlot[3]`,
    // each { sendTime, promptText, credit }.
    match /daily_schedules/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- groups/{groupId} ---
    // { name, memberIds, inviteCode, createdBy, createdAt }. Mutated only
    // via the createGroup / joinGroupByInviteCode Cloud Functions callables
    // (Admin SDK) — never directly by clients, so invite-code uniqueness
    // can be enforced with a server-side transaction. Members can list
    // their own group via `where('memberIds', 'array-contains', uid)`,
    // which this rule permits (Firestore evaluates list queries against
    // this rule per matching document).
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    // --- invite_codes/{code} ---
    // { groupId } — lookup-only doc used by joinGroupByInviteCode.
    // Never read or written by clients directly (the callable does the
    // lookup with the Admin SDK) — if it were client-readable, anyone
    // could enumerate/guess codes without going through the join flow's
    // validation.
    match /invite_codes/{code} {
      allow read, write: if false;
    }

    // --- posts/{postId} ---
    // { groupId, userId, date, slotNumber, photoUrl, postedAt, isPublic,
    //   caption, likeCount }
    match /posts/{postId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isGroupMember(request.resource.data.groupId)
                    // likeCount must start at 0 — only the likes trigger
                    // (Admin SDK) ever changes it after creation.
                    && request.resource.data.likeCount == 0;
      // Visible to your group always; visible to ANYONE signed in if the
      // author chose to make it public (the "みんなの投稿" feed) — see
      // Post.isPublic's doc comment in shared-types.
      allow read: if isSignedIn()
                  && (resource.data.isPublic == true || isGroupMember(resource.data.groupId));
      // Authors don't edit/delete posts per spec (no editing feature).
      // likeCount is the one field non-admins never touch directly either
      // — see posts/{postId}/likes/{uid} below, which drives it via a
      // server-side trigger instead of a client-writable counter.
      allow update, delete: if isAdmin();

      // --- posts/{postId}/likes/{uid} ---
      // Doc id IS the liker's uid — "like" = create this doc,
      // "unlike" = delete it. Existence alone is the signal (see Like's
      // doc comment in shared-types). Anyone who can read the post can
      // see (and cast) likes on it; a user can only create/delete their
      // OWN like doc, never anyone else's.
      match /likes/{uid} {
        allow read: if isSignedIn()
                    && (get(/databases/$(database)/documents/posts/$(postId)).data.isPublic == true
                        || isGroupMember(get(/databases/$(database)/documents/posts/$(postId)).data.groupId));
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false; // no fields to update — recreate instead
      }

      // --- posts/{postId}/comments/{commentId} ---
      // { userId, displayName, text, createdAt }
      match /comments/{commentId} {
        allow read: if isSignedIn()
                    && (get(/databases/$(database)/documents/posts/$(postId)).data.isPublic == true
                        || isGroupMember(get(/databases/$(database)/documents/posts/$(postId)).data.groupId));
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280;
        // No edit/delete-by-author for the same reason posts themselves
        // don't have one — keep the "no editing" posture consistent.
        allow update, delete: if isAdmin();
      }
    }

    // --- prompt_suggestions/{suggestionId} ---
    // { suggestionText, submitterInfo: { uid, displayName }, status, createdAt }
    match /prompt_suggestions/{suggestionId} {
      allow create: if isSignedIn()
                    && request.resource.data.submitterInfo.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.submitterInfo.uid == request.auth.uid);
      allow update: if isAdmin(); // approve/reject transitions are admin-only
      allow delete: if isAdmin();
    }

    // --- prompt_pool/{entryId} ---
    // "Popular prompt" stock used by the 00:00 auto-fill batch job.
    // { promptText, usageCount, createdAt }
    match /prompt_pool/{entryId} {
      allow read: if isAdmin(); // not user-facing; batch job reads via Admin SDK anyway
      allow write: if isAdmin();
    }

    // Default deny — anything not explicitly matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

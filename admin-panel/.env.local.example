# Copy to .env.local and fill in from your Firebase project's Web App config
# (Firebase Console → Project Settings → Your apps → SDK setup and config).
# These NEXT_PUBLIC_* values are client identifiers, safe to expose to the
# browser — they are not secrets. Real secrets (Admin SDK service account)
# are handled separately below.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the client SDK at the local Emulator Suite instead of production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# --- Server-only (never prefixed NEXT_PUBLIC_, never sent to the browser) ---
# Path to (or JSON contents of) a service account key for the Admin SDK,
# used by src/lib/firebase/admin.ts. Do NOT commit the actual key file —
# see the root .gitignore. In production, prefer a managed identity
# (e.g. Vercel's Google Cloud integration / Workload Identity) over a raw
# key file where possible.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

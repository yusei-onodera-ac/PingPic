rules_version = '2';

// PingPic Storage security rules.
// Inferred requirement: posts.photoUrl implies a Storage bucket, though the
// design doc's data model section never names one explicitly.
//
// Cost note: photo uploads are the main storage/egress cost driver. Client
// (Flutter) MUST compress/resize before upload — see
// mobile/lib/features/camera/data/camera_repository.dart TODO. Do not raise
// these size limits without re-checking Firebase Storage free-tier quotas.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Cross-service read of the groups collection (Firestore) to check
    // membership. Path must use the literal "(default)" database id —
    // Storage rules don't have Firestore rules' $(database) variable.
    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in
          firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    // posts/{groupId}/{uid}/{postId}.jpg — groupId is embedded in the path
    // (not just uid) specifically so this rule can check group membership
    // without needing custom object metadata — see
    // mobile/lib/features/camera/data/camera_repository.dart for the
    // matching upload path construction.
    match /posts/{groupId}/{uid}/{fileName} {
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && isGroupMember(groupId)
                   && request.resource.size < 8 * 1024 * 1024 // 8MB cap, cost guardrail
                   && request.resource.contentType.matches('image/.*');
      allow read: if isGroupMember(groupId);
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

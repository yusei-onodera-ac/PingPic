rules_version = '2';

// PingPic Storage security rules.
// Inferred requirement: posts.photoUrl implies a Storage bucket, though the
// design doc's data model section never names one explicitly.
//
// Cost note: photo uploads are the main storage/egress cost driver. Client
// (Flutter) MUST compress/resize before upload — see
// mobile/lib/features/camera/application/camera_controller.dart's
// capture(). Do not raise the size cap below without re-checking Firebase
// Storage free-tier quotas.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Cross-service reads of Firestore to check post visibility — same
    // privacy model as firestore.rules' posts.allow read (owner, mutual
    // connection, or the post is public). Storage rules don't have
    // Firestore rules' $(database) variable — the literal "(default)" is
    // required instead. Mirrors firestore.rules' connectionId().
    function connectionId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isConnected(a, b) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/connections/$(connectionId(a, b)));
    }

    function canReadPost(postId) {
      let post = firestore.get(/databases/(default)/documents/posts/$(postId)).data;
      return post.isPublic == true
        || request.auth.uid == post.userId
        || isConnected(request.auth.uid, post.userId);
    }

    // posts/{uid}/{postId}.jpg — one unedited photo per post, owner-
    // uploaded. postId is recovered from the filename (strip ".jpg") to
    // look the post up in Firestore for the read check above.
    match /posts/{uid}/{fileName} {
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024 // 8MB cap, cost guardrail
                   && request.resource.contentType.matches('image/.*');
      allow read: if canReadPost(fileName.split('.')[0]);
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

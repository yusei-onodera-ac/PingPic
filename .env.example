# Root-level cross-cutting vars only. Each sub-project has its own
# .env.example with project-specific variables:
#   - admin-panel/.env.local.example
#   - functions/ uses `firebase functions:secrets:set` for real secrets
#     (APNs key, etc.) — NOT a .env file. See docs/SETUP.md.
#   - mobile/ uses firebase_options.dart generated by `flutterfire configure`
#     (not a .env file).

# Firebase project id shared across functions/admin-panel/mobile for local dev.
FIREBASE_PROJECT_ID=pingpic-dev

# Set to "true" to point local dev tooling at the Firebase Emulator Suite
# instead of a real project.
USE_FIREBASE_EMULATOR=true
